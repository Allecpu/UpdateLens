{
    "name": "updatelens",
    "private": true,
    "version": "0.5.0",
    "type": "module",
    "scripts": {
        "server:dev": "tsx server/index.ts",
        "test:releaseplans": "tsx tools/releaseplansUrlCheck.ts",
        "test:deck": "tsx tools/deckSmokeTest.ts",
        "refresh:all": "npm run refresh:microsoft && npm run refresh:eos && npm run refresh:m365roadmap && npm run refresh:fabric",
        "refresh:eos": "tsx tools/refreshEos.ts",
        "refresh:m365roadmap": "tsx tools/refreshM365Roadmap.ts",
        "build": "vite build",
        "ingest:releaseplans": "tsx server/ingest.ts",
        "refresh:microsoft": "tsx tools/refreshMicrosoft.ts",
        "dev": "vite",
        "build:server": "tsc -p server/tsconfig.json",
        "prestart:server": "npm run build:server",
        "start:server": "node server-dist/index.js",
        "preview": "vite preview",
        "typecheck": "tsc -b --pretty false",
        "refresh:fabric": "tsx tools/refreshFabric.ts",
        "test:chat-api": "tsx tools/testChatApi.ts",
        "test:chat-intent": "tsx tools/testChatIntent.ts",
        "test:chat-response": "tsx tools/testChatResponse.ts",
        "test:chat-unit": "npm run test:chat-intent && npm run test:chat-response"
    },
    "dependencies": {
        "better-sqlite3": "^9.6.0",
        "express": "^4.19.2",
        "jszip": "^3.10.1",
        "node-cron": "^3.0.3",
        "pptxgenjs": "^4.0.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.26.2",
        "uuid": "^14.0.1",
        "zod": "^3.25.76",
        "zustand": "^4.5.5"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.10",
        "@types/express": "^4.17.21",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "autoprefixer": "^10.4.19",
        "cheerio": "^1.0.0-rc.12",
        "postcss": "^8.4.39",
        "tailwindcss": "^3.4.7",
        "tsx": "^4.16.0",
        "typescript": "^5.5.3",
        "vite": "^5.4.1"
    }
}
