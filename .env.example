# Core server
PORT=4000
NODE_ENV=development

# Chat engine selection: local | azure
CHAT_ENGINE=local
CHAT_AZURE_MIN_CONFIDENCE=0.6

# Azure OpenAI (required when CHAT_ENGINE=azure or preferAzure=true)
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=<azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21

# CSS meeting report extraction mode: auto_heuristic_first | heuristic_only | azure_only
CSS_IMPORT_EXTRACTION_MODE=auto_heuristic_first
# CSS Azure retry behavior for 429/503 during extract
CSS_AZURE_RETRY_MAX_ATTEMPTS=3
CSS_AZURE_MAX_TEXT_CHARS=10000

# Application Insights (optional, server-side telemetry)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<key>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

# Frontend flags (.env for Vite)
VITE_CHAT_BACKEND_ENABLED=true
VITE_CHAT_AZURE_LLM_ENABLED=false
